#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

BIN_DIR="${CODE_SANDBOX_BIN_DIR:-${HOME}/.local/bin}"
BIN_NAME="${CODE_SANDBOX_BIN_NAME:-sandbox}"
DATA_DIR="${CODE_SANDBOX_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/code-sandbox}"
CONFIG_DIR="${CODE_SANDBOX_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/code-sandbox}"
CONFIG_FILE="${CODE_SANDBOX_CONFIG:-${CONFIG_DIR}/.env}"

mkdir -p "$BIN_DIR" "$DATA_DIR" "$(dirname "$CONFIG_FILE")"

install -m 755 "${SCRIPT_DIR}/code-sandbox" "${BIN_DIR}/${BIN_NAME}"
install -m 644 "${SCRIPT_DIR}/Dockerfile" "${DATA_DIR}/Dockerfile"

if [[ ! -f "$CONFIG_FILE" ]]; then
  install -m 600 "${SCRIPT_DIR}/.env" "$CONFIG_FILE"
else
  echo "Keeping existing config: ${CONFIG_FILE}"
fi

cat <<EOF
Installed ${BIN_NAME}.

Executable: ${BIN_DIR}/${BIN_NAME}
Dockerfile: ${DATA_DIR}/Dockerfile
Config:     ${CONFIG_FILE}

Make sure ${BIN_DIR} is in your PATH, then run:
  ${BIN_NAME} <project-path>
EOF

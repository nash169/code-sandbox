# Cuda version
CUDA_TAG=13.1.0

# OAuth callback port on host
HOST_OAUTH_PORT=

# opencode
OPENCODE_CONFIG=$HOME/.config/opencode
OPENCODE_SHARE=$HOME/.local/share/opencode
OPENCODE_CACHE=$HOME/.cache/opencode

# uv
UV_CACHE=$HOME/.cache/uv
UV_LOCAL=$HOME/.local/share/uv

# workspace
WORKSPACE=/home/bernardo/ws/opencode

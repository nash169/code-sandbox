#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DEFAULT_DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/code-sandbox"
DEFAULT_CONFIG_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/code-sandbox/.env"

if [[ -n "${CODE_SANDBOX_DATA_DIR-}" ]]; then
  DATA_DIR="$CODE_SANDBOX_DATA_DIR"
elif [[ -f "${DEFAULT_DATA_DIR}/Dockerfile" ]]; then
  DATA_DIR="$DEFAULT_DATA_DIR"
else
  DATA_DIR="$SCRIPT_DIR"
fi

DOCKERFILE="${DATA_DIR}/Dockerfile"
SKILLS_DIR="${DATA_DIR}/llm-skills"

if [[ -n "${CODE_SANDBOX_CONFIG-}" ]]; then
  CONFIG_FILE="$CODE_SANDBOX_CONFIG"
elif [[ -f "$DEFAULT_CONFIG_FILE" ]]; then
  CONFIG_FILE="$DEFAULT_CONFIG_FILE"
else
  CONFIG_FILE="${SCRIPT_DIR}/.env"
fi

# Auto-load config if present
if [[ -f "$CONFIG_FILE" ]]; then
  set -a
  source "$CONFIG_FILE"
  set +a
fi

docker-label() {
  docker inspect --format='{{ index .Config.Labels "'"${2}"'" }}' "${1}" 2>/dev/null
}

docker-port-busy() {
    local HOST=$1
    local PORT=$2
    docker ps --format '{{.Ports}}' | grep -qE "(^|[ ,])${HOST}:${PORT}->" && return 0
    return 1
}

# Mount each skill read-only into a harness skills directory
add-skills() {
  local skill
  for skill in "${SKILLS_DIR}"/*/; do
    [[ -f "${skill}SKILL.md" ]] || continue
    RUN_ARGS+=( -v "${skill%/}:${1}/$(basename "$skill"):ro" )
  done
}

CONTAINER_IMAGE="code-sandbox"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME} [options] [project-path...]

Options:
  -i, --image NAME  Use a specific Docker image name
  -h, --help        Show this help text
EOF
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--image)
      if [[ -z "${2-}" ]]; then
        echo "Error: --image requires a value" >&2
        exit 1
      fi
      CONTAINER_IMAGE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done
if (( ${#POSITIONAL[@]} )); then
  set -- "${POSITIONAL[@]}"
else
  set --
fi

if ! docker image inspect "${CONTAINER_IMAGE}" >/dev/null 2>&1; then
  whiptail --title "Code Sandbox" --yesno "Install Code Sandbox?" 8 78 || { echo "User exit"; exit; }

  if [[ ! -f "$DOCKERFILE" ]]; then
    echo "Error: Dockerfile not found: $DOCKERFILE" >&2
    echo "Run ./install or set CODE_SANDBOX_DATA_DIR to the installed data directory." >&2
    exit 1
  fi

  BASE_IMAGE="ubuntu:24.04"

  BUILD_ARGS=(
    build
    --no-cache
    --build-arg UID=$(id -u)
    --build-arg GID=$(id -g)
  )

  CHOICES=$(whiptail --title "Code Sandbox" --checklist \
      "Choose your tools" 20 49 12 \
      "cuda" "Nvidia CUDA" OFF \
      "uv" "Python virtual environment" OFF \
      "opencode" "opensource llm cli" OFF \
      "claude-code" "anthropic llm cli" OFF \
      "codex" "openai llm cli" OFF \
      "pi" "pi.dev coding agent" OFF \
      "neovim" "Neovim editor" OFF \
      "latex" "LaTeX" OFF 3>&1 1>&2 2>&3) || { echo "User exit"; exit; }

  for CHOICE in $CHOICES; do
    CHOICE="${CHOICE%\"}"
    CHOICE="${CHOICE#\"}"
    case $CHOICE in
      "cuda")
          BUILD_ARGS+=( --build-arg CUDA_INSTALL=true )
          BASE_IMAGE="nvidia/cuda:${CUDA_TAG:-"13.4.3-cudnn-devel-ubuntu26.04"}"
          ;;
      "uv")
          BUILD_ARGS+=( --build-arg UV_INSTALL=true )
          ;;
      "opencode")
          BUILD_ARGS+=( --build-arg OPENCODE_INSTALL=true )
          ;;
      "claude-code")
          BUILD_ARGS+=( --build-arg CLAUDECODE_INSTALL=true )
          ;;
      "codex")
          BUILD_ARGS+=( --build-arg CODEX_INSTALL=true )
          ;;
      "pi")
          BUILD_ARGS+=( --build-arg PI_INSTALL=true )
          ;;
      "neovim")
          BUILD_ARGS+=( --build-arg NEOVIM_INSTALL=true )
          ;;
      "latex")
          BUILD_ARGS+=( --build-arg LATEX_INSTALL=true )
          ;;
    esac
  done

  BUILD_ARGS+=(
    --build-arg BASE_IMAGE=${BASE_IMAGE}
  )

  docker "${BUILD_ARGS[@]}" \
    -f "${DOCKERFILE}" \
    -t "${CONTAINER_IMAGE}" \
    "${DATA_DIR}"
fi

CONTAINER_HOME=/home/ubuntu

RUN_ARGS=(
  run
  --rm
  -it
  --name "code-sandbox_$(uuidgen | cut -d- -f1)"
)

[ "$(docker-label "${CONTAINER_IMAGE}" cuda)" = true ] && \
  RUN_ARGS+=(
    --gpus all
    # --device nvidia.com/gpu=all
  )

[ "$(docker-label "${CONTAINER_IMAGE}" uv)" = true ] && \
  RUN_ARGS+=(
    -v "${UV_CONFIG:-uv_config}:${CONTAINER_HOME}/.config/uv"
    -v "${UV_SHARE:-uv_share}:${CONTAINER_HOME}/.local/share/uv"
    -v "${UV_CACHE:-uv_cache}:${CONTAINER_HOME}/.cache/uv"
  )

[ "$(docker-label "${CONTAINER_IMAGE}" neovim)" = true ] && \
  RUN_ARGS+=(
    -v "${NEOVIM_CONFIG:-${NVIM_CONFIG:-nvim_config}}:${CONTAINER_HOME}/.config/nvim"
    -v "${NEOVIM_SHARE:-${NVIM_SHARE:-nvim_share}}:${CONTAINER_HOME}/.local/share/nvim"
    -v "${NEOVIM_STATE:-${NVIM_STATE:-nvim_state}}:${CONTAINER_HOME}/.local/state/nvim"
    -v "${NEOVIM_CACHE:-${NVIM_CACHE:-nvim_cache}}:${CONTAINER_HOME}/.cache/nvim"
  )

[ "$(docker-label "${CONTAINER_IMAGE}" latex)" = true ] && \
  RUN_ARGS+=(
    -v "${LATEXMK_CONFIG:-latexmk_config}:${CONTAINER_HOME}/.config/latexmk"
  )

HOST=127.0.0.1
AUTH_PORT=1455
while docker-port-busy "$HOST" "$AUTH_PORT"; do
    AUTH_PORT=$((AUTH_PORT+1))
done

if [ "$(docker-label "${CONTAINER_IMAGE}" opencode)" = true ] || [ "$(docker-label "${CONTAINER_IMAGE}" codex)" = true ]; then
  RUN_ARGS+=(
    -p "${HOST}:${AUTH_PORT}:1456"
  )
fi

[ "$(docker-label "${CONTAINER_IMAGE}" opencode)" = true ] && \
  RUN_ARGS+=(
    -v "${OPENCODE_CONFIG:-opencode_config}:${CONTAINER_HOME}/.config/opencode"
    -v "${OPENCODE_SHARE:-opencode_share}:${CONTAINER_HOME}/.local/share/opencode"
    -v "${OPENCODE_CACHE:-opencode_cache}:${CONTAINER_HOME}/.cache/opencode"
  )

[ "$(docker-label "${CONTAINER_IMAGE}" claudecode)" = true ] && \
  RUN_ARGS+=(
    -e "CLAUDE_CONFIG_DIR=${CONTAINER_HOME}/.claude"
    -v "${CLAUDE_CODE_CONFIG:-claude_code_config}:${CONTAINER_HOME}/.claude"
    -v "${CLAUDE_CODE_CACHE:-claude_code_cache}:${CONTAINER_HOME}/.cache/claude"
  )

[ "$(docker-label "${CONTAINER_IMAGE}" codex)" = true ] && \
  RUN_ARGS+=(
    -v "${CODEX_HOME:-codex_home}:${CONTAINER_HOME}/.codex"
  )

[ "$(docker-label "${CONTAINER_IMAGE}" pi)" = true ] && \
  RUN_ARGS+=(
    -v "${PI_AGENT_HOME:-pi_agent_home}:${CONTAINER_HOME}/.pi/agent"
  )

[ "$(docker-label "${CONTAINER_IMAGE}" opencode)" = true ] && add-skills "${CONTAINER_HOME}/.config/opencode/skills"
[ "$(docker-label "${CONTAINER_IMAGE}" claudecode)" = true ] && add-skills "${CONTAINER_HOME}/.claude/skills"
[ "$(docker-label "${CONTAINER_IMAGE}" codex)" = true ] && add-skills "${CONTAINER_HOME}/.agents/skills"
[ "$(docker-label "${CONTAINER_IMAGE}" pi)" = true ] && add-skills "${CONTAINER_HOME}/.pi/agent/skills"

if [[ -z "${WORKSPACE-}" ]]; then
  WORKSPACE="$(mktemp -d /tmp/code_sandbox_workspace-XXXXXX)" || return 1
  chmod 1777 "$WORKSPACE" || return 1
  echo $WORKSPACE
fi
RUN_ARGS+=(
  -w /workspace
  -v "${WORKSPACE}:/workspace"
)

# Mount projects passed as args
for p in "$@"; do
  p="${p/#\~/$HOME}"
  if [[ ! -d "$p" ]]; then
    echo "Error: not a directory: $p" >&2
    exit 1
  fi

  abs="$(cd "$p" && pwd -P)"
  name="$(basename "$abs")"

  # Prevent accidental collisions (two projects with same basename)
  if [[ " ${RUN_ARGS[*]} " == *":/workspace/${name} "* ]]; then
    echo "Error: duplicate mount name /workspace/${name} (two paths share basename '${name}')" >&2
    echo "Tip: rename one folder or I can modify the script to mount with unique names." >&2
    exit 1
  fi

  RUN_ARGS+=(-v "${abs}:${CONTAINER_HOME}/${name}")
done

exec docker "${RUN_ARGS[@]}" "${CONTAINER_IMAGE}" bash
